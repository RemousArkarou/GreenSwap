<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GreenSwap.Pages.Plant.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GreenSwap.Pages.Plant"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#1A1A1A">
        <ScrollViewer>
            <StackPanel Padding="20" Spacing="25">

                <!-- Back Button -->
                <Button
                    Content="← Back"
                    HorizontalAlignment="Left"
                    Background="#333333"
                    Foreground="White"
                    Padding="12,5"
                    CornerRadius="4"
                    Click="BackButton_Click"/>

                <!-- Filter Section: Dark Card Style -->
                <Border
                    Padding="20"
                    CornerRadius="12"
                    Background="#252525" 
                    HorizontalAlignment="Left"
                    Width="300"
                    BorderBrush="#333333"
                    BorderThickness="1">

                    <StackPanel Spacing="15">
                        <TextBlock
                            Text="Filters"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#98FF98"/>

                        <TextBox
                            x:Name="NameFilterBox"
                            Header="Name"
                            PlaceholderText="Search plants..."
                            Background="#333333"
                            Foreground="White"
                            BorderThickness="0,0,0,1"/>

                        <ComboBox
                            x:Name="CategoryFilterBox"
                            Header="Category"
                            HorizontalAlignment="Stretch"
                            Background="#333333"
                            Foreground="White">
                            <ComboBoxItem Content="All" IsSelected="True"/>
                            <ComboBoxItem Content="Kamerplant"/>
                            <ComboBoxItem Content="Vetplant"/>
                            <ComboBoxItem Content="Bloemplant"/>
                        </ComboBox>

                        <Button
                            Content="Apply Filters"
                            HorizontalAlignment="Stretch"
                            Background="#98FF98"
                            Foreground="Black"
                            FontWeight="Bold"
                            Height="40"
                            CornerRadius="6"
                            Click="FilterButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Items List: Gebaseerd op AppDbContext Seeders -->
                <ListView x:Name="ItemsListView" SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,15"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <!-- Mint Kleur: #98FF98 | Tekst: Zwart geforceerd -->
                            <Border 
                                Background="#98FF98" 
                                CornerRadius="12" 
                                Padding="15" 
                                RequestedTheme="Light">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Image Binding naar 'Image' property -->
                                    <Image Source="{Binding Image}" Width="80" Height="80" Stretch="UniformToFill"/>

                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="20" Foreground="Black"/>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding PlantType}" Foreground="#444444" FontSize="14"/>
                                            <TextBlock Text="•" Foreground="#444444"/>
                                            <TextBlock Text="{Binding Rarity}" Foreground="#444444" FontSize="14" FontStyle="Italic"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="#666666"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                                        <!-- Prijs weergave -->
                                        <TextBlock Text="{Binding CreditPrice}" 
                                                   HorizontalAlignment="Right" 
                                                   FontWeight="Bold" 
                                                   Foreground="Black" 
                                                   FontSize="16"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Text="Credits" HorizontalAlignment="Right" FontSize="10" Foreground="Black" Margin="0,-8,5,5"/>

                                        <Button Content="Details" HorizontalAlignment="Stretch" Background="White" Foreground="Black" CornerRadius="4" Click="DetailsButton_Click"/>
                                        <Button Content="Trade" HorizontalAlignment="Stretch" Background="#1A1A1A" Foreground="White" CornerRadius="4" Click="TradeButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>