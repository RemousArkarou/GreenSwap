<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GreenSwap.Pages.Login.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GreenSwap.Pages.Login"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#1E1E1E"/>
        </Grid.Background>

        <Border Width="450"
                Background="#252525"
                CornerRadius="10"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#444"
                BorderThickness="1">

            <StackPanel Spacing="20">

                <TextBlock Text="Account Registreren"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#98FF98"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Maak een nieuw GreenSwap account"
                           FontSize="16"
                           Foreground="WhiteSmoke"
                           HorizontalAlignment="Center"/>

                <!-- Naam -->
                <TextBox x:Name="NameTextBox"
                         PlaceholderText="Naam"
                         Height="45"
                         FontSize="16"
                         Background="#333333"
                         Foreground="White"
                         BorderBrush="#555"
                         BorderThickness="1"
                         Padding="10"/>

                <!-- Email -->
                <TextBox x:Name="EmailTextBox"
                         PlaceholderText="E-mailadres"
                         Height="45"
                         FontSize="16"
                         Background="#333333"
                         Foreground="White"
                         BorderBrush="#555"
                         BorderThickness="1"
                         Padding="10"/>

                <!-- Wachtwoord -->
                <PasswordBox x:Name="PasswordTextBox"
                             PlaceholderText="Wachtwoord"
                             Height="45"
                             FontSize="16"
                             Background="#333333"
                             Foreground="White"
                             BorderBrush="#555"
                             BorderThickness="1"
                             Padding="10"/>

                <!-- Confirm wachtwoord -->
                <PasswordBox x:Name="ConfirmPasswordTextBox"
                             PlaceholderText="Bevestig wachtwoord"
                             Height="45"
                             FontSize="16"
                             Background="#333333"
                             Foreground="White"
                             BorderBrush="#555"
                             BorderThickness="1"
                             Padding="10"/>

                <!-- Register knop -->
                <Button x:Name="RegisterButton"
                        Content="REGISTREREN"
                        Click="RegisterButton_Click"
                        Height="50"
                        FontSize="18"
                        FontWeight="Bold"
                        Background="#98FF98"
                        Foreground="Black"
                        BorderThickness="0"/>

                <!-- Error -->
                <TextBlock x:Name="ErrorMessage"
                           Foreground="Red"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Page>